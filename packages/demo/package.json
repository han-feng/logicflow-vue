{
  "name": "logicflow-vue-demo",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@7.1.0",
  "description": "Logic Flow Vue Demo",
  "scripts": {
    "all": "pnpm clean && pnpm build",
    "dev": "vite --open",
    "build": "vite build && node script/crlf.js",
    "build:check": "vue-tsc --project tsconfig.build.json --noEmit && vite build && node script/crlf.js",
    "preview": "vite preview --open",
    "preview:ci": "vite preview",
    "cy:run": "cypress install && cypress run",
    "test": "pnpm test:e2e",
    "test:e2e": "start-server-and-test 'vite preview' http://127.0.0.1:4173/ 'pnpm cy:run'",
    "clean": "rimraf dist",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@logicflow/core": "^1.2.28",
    "@logicflow/extension": "^1.2.28",
    "ant-design-vue": "^4.2.6",
    "consola": "^3.4.2",
    "highlight.js": "^11.11.1",
    "ids": "^1.0.5",
    "lodash-es": "^4.17.21",
    "logicflow-bpmn": "workspace:^",
    "logicflow-useapi": "workspace:^",
    "resize-detector": "^0.3.0",
    "splitpanes": "^4.0.4",
    "vue": "^3.5.22"
  },
  "optionalDependencies": {
    "cypress": "^15.3.0",
    "jimp": "^1.6.0",
    "start-server-and-test": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.3",
    "rollup-plugin-visualizer": "^6.0.4",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.8",
    "vite-plugin-resolve-externals": "^0.2.2",
    "vite-plugin-style-import": "^2.0.0",
    "vue-tsc": "^3.1.0"
  }
}
